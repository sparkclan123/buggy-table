{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window can use database APIs and guard window closing.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-connect",
    "allow-disconnect",
    "allow-run-query",
    "allow-cancel-query",
    "allow-browse-table",
    "allow-count-table-rows",
    "allow-inspect-table",
    "allow-get-overview",
    "allow-save-table-changes",
    "allow-redis-command",
    "allow-check-update",
    "allow-install-update",
    "allow-open-download-page",
    "core:window:allow-set-theme",
    "allow-list-connections",
    "allow-connect-profile",
    "allow-reconnect-profile",
    "allow-update-connection",
    "allow-remove-connection",
    "allow-list-schemas",
    "allow-list-databases",
    "allow-schema-tables",
    "allow-vpn-profiles",
    "allow-discard-vpn-draft",
    "allow-save-vpn-profile",
    "allow-remove-vpn-profile",
    "allow-vpn-runtime",
    "allow-prepare-vpn",
    "allow-vpn-status",
    "allow-set-connection-vpn"
  ]
}
