{
  "name": "buggy-table",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --tests -- --include-ignored --test-threads=1",
    "format": "prettier --write src tests/ui *.json *.ts *.js && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src tests/ui *.json *.ts *.js && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "release:key": "node scripts/init-updater-key.mjs",
    "release:version": "node scripts/version.mjs",
    "release:check": "node scripts/version.mjs --check && node --test scripts/release-assets.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lucide/svelte": "^1.56.0",
    "@tauri-apps/api": "^2.8.0",
    "codemirror": "^6.0.2",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
